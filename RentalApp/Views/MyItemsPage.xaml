<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RentalApp.Views.MyItemsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             Title="My Items">

    <CollectionView ItemsSource="{Binding MyItems}"
                    Margin="10"
                    SelectionMode="None">

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="20"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="You haven't listed any items yet."
                       FontSize="18"
                       TextColor="Gray" />
                <Label Text="Use the Create Item button on the dashboard to add one."
                       FontSize="14"
                       TextColor="Gray"
                       Margin="0,5,0,0" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Stroke="#ddd"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="15"
                        Margin="0,0,0,10"
                        StrokeShape="RoundRectangle 10">

                    <VerticalStackLayout>

                        <Label Text="{Binding Title}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="{Binding Category}"
                               FontSize="14"
                               TextColor="Gray" />

                        <Label Text="{Binding Status}"
                               FontSize="14"
                               TextColor="DarkGreen"
                               Margin="0,5,0,0" />

                        <Button Text="View Rental Requests"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyItemsViewModel}}, Path=ViewRequestsCommand}"
                                CommandParameter="{Binding Id}"
                                BackgroundColor="#007aff"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="0,10,0,0" />

                    </VerticalStackLayout>

                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
