<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RentalApp.Views.MyItemsPage"
             x:Name="RootPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             Title="My Items">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="25">

            <!-- AVAILABLE ITEMS SECTION -->
            <VerticalStackLayout>
                <Label Text="Available Items"
                       FontSize="22"
                       FontAttributes="Bold"
                       Margin="0,0,0,10"/>

                <CollectionView ItemsSource="{Binding AvailableItems}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label Text="No available items."
                               HorizontalOptions="Center"
                               TextColor="Gray"
                               FontSize="16"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#ddd"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="15"
                                    Margin="0,0,0,10"
                                    StrokeShape="RoundRectangle 10">

                                <VerticalStackLayout>

                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Category}"
                                           FontSize="14"
                                           TextColor="Gray" />

                                    <Label Text="Available"
                                           FontSize="14"
                                           TextColor="DarkGreen"
                                           Margin="0,5,0,0" />

                                    <Button Text="View Rental Requests"
                                            Command="{Binding BindingContext.ViewRentalRequestsCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="#007aff"
                                            TextColor="White"
                                            CornerRadius="8"
                                            Margin="0,10,0,0" />

                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </VerticalStackLayout>


            <!-- RENTED OUT ITEMS SECTION -->
            <VerticalStackLayout>
                <Label Text="Rented Out Items"
                       FontSize="22"
                       FontAttributes="Bold"
                       Margin="0,0,0,10"/>

                <CollectionView ItemsSource="{Binding RentedOutItems}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label Text="No rented-out items."
                               HorizontalOptions="Center"
                               TextColor="Gray"
                               FontSize="16"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#ddd"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="15"
                                    Margin="0,0,0,10"
                                    StrokeShape="RoundRectangle 10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyItemsViewModel}}, Path=OpenRentalDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <!-- Item Title -->
                                    <Label Text="{Binding ItemTitle}"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <!-- Borrower -->
                                    <Label Text="{Binding BorrowerName, StringFormat='Borrowed by: {0}'}"
                                           FontSize="14"
                                           TextColor="Gray"
                                           IsVisible="{Binding BorrowerName, Converter={StaticResource NullToBoolConverter}}"/>

                                    <!-- Date Range -->
                                    <Label Text="{Binding DateRange}"
                                           FontSize="14"
                                           TextColor="Gray"
                                           IsVisible="{Binding DateRange, Converter={StaticResource NullToBoolConverter}}"/>

                                    <!-- Status -->
                                    <Label Text="{Binding Status}"
                                           FontSize="14"
                                           TextColor="DarkRed"
                                           FontAttributes="Bold"/>

                                    <!-- Total Price -->
                                    <Label Text="{Binding TotalPriceFormatted}"
                                           FontSize="14"
                                           TextColor="Gray"/>

                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
