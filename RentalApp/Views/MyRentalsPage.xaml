<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    x:Class="RentalApp.Views.MyRentalsPage"
    Title="My Rentals">

    <Grid RowDefinitions="Auto, *">

        <!-- Error Banner -->
        <Border 
            BackgroundColor="#ffcccc"
            Padding="10"
            IsVisible="{Binding HasError}">
            <Label 
                Text="{Binding ErrorMessage}" 
                TextColor="Black" 
                FontAttributes="Bold" />
        </Border>

        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                ItemsSource="{Binding Rentals}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <Label 
                            Text="You have no rentals yet."
                            FontSize="18"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border 
                            Margin="10"
                            Padding="15"
                            BackgroundColor="White"
                            Stroke="#dddddd"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">

                            <Border.Shadow>
                                <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="6">

                                <!-- Item Title -->
                                <Label 
                                    Text="{Binding ItemTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#222" />

                                <!-- Category -->
                                <Label 
                                    Text="{Binding Category, StringFormat='Category: {0}'}"
                                    FontSize="14"
                                    TextColor="#555" />

                                <!-- Daily Rate -->
                                <Label 
                                    Text="{Binding DailyRate, StringFormat='Daily Rate: £{0}'}"
                                    FontSize="14"
                                    TextColor="#555" />

                                <!-- Rental Status -->
                                <Label 
                                    Text="{Binding Rental.Status}"
                                    FontSize="14"
                                    TextColor="#007aff"
                                    FontAttributes="Bold" />

                                <!-- Dates -->
                                <Label 
                                    Text="{Binding Rental.StartDate, StringFormat='From: {0:dd MMM yyyy}'}"
                                    FontSize="14"
                                    TextColor="#555" />

                                <Label 
                                    Text="{Binding Rental.EndDate, StringFormat='To: {0:dd MMM yyyy}'}"
                                    FontSize="14"
                                    TextColor="#555" />

                                <!-- Mark Returned -->
                                <Button 
                                    Text="Mark Returned"
                                    BackgroundColor="#007aff"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyRentalsViewModel}}, Path=MarkReturnedCommand}"
                                    CommandParameter="{Binding Rental.ApiRentalId}"
                                    IsVisible="{Binding Rental.Status, Converter={StaticResource StatusToReturnVisibleConverter}}" />

                                <!-- Add Review Button -->
                                <!-- Add Review Button -->
                                <Button 
                                    Text="Add Review"
                                    BackgroundColor="#007aff"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="50"
                                    Margin="0,10,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyRentalsViewModel}}, Path=AddReviewCommand}"
                                    CommandParameter="{Binding Rental.ApiRentalId}"
                                    IsVisible="{Binding Rental.Status, Converter={StaticResource StatusToReviewVisibleConverter}}" />


                            </VerticalStackLayout>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
