<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
             x:Class="RentalApp.Views.RentalDetailsPage"
             Title="Rental Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Item ID -->
            <Label Text="{Binding Rental.ApiItemId, StringFormat='Item ID: {0}'}"
                   FontSize="26"
                   FontAttributes="Bold" />

            <!-- Borrower -->
            <Label Text="Borrower:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Rental.BorrowerId}" />

            <!-- Status -->
            <Label Text="Status:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Rental.Status}" />

            <!-- Last Updated -->
            <Label Text="Last Updated:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Rental.LastSynced, StringFormat='{0:dd MMM yyyy HH:mm}'}" />

              <!-- OWNER: Mark Out For Rent -->
            <Button Text="Mark Out For Rent"
                    Command="{Binding MarkOutForRentCommand}"
                    IsVisible="{Binding ShowMarkOutForRent}" />

            <!-- BORROWER: Mark Returned -->
            <Button Text="Mark Returned"
                    Command="{Binding MarkReturnedCommand}"
                    IsVisible="{Binding ShowMarkReturned}" />

            <!-- OWNER: Mark Completed -->
            <Button Text="Mark Completed"
                    Command="{Binding MarkCompletedCommand}"
                    IsVisible="{Binding ShowCompleted}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
