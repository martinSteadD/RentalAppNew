<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    x:Class="RentalApp.Views.BrowseItemsPage"
    Title="Browse Items">

    <!-- IMPORTANT: No BindingContext here.
         DI sets it in BrowseItemsPage.xaml.cs -->

    <Grid RowDefinitions="Auto, *">

        <!-- Error Banner -->
        <Border 
            BackgroundColor="#ffcccc"
            Padding="10"
            IsVisible="{Binding HasError}">
            <Label 
                Text="{Binding ErrorMessage}" 
                TextColor="Black" 
                FontAttributes="Bold" />
        </Border>

        <!-- Items List wrapped in RefreshView (MAUI 9 requirement) -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border 
                            Margin="10"
                            Padding="15"
                            BackgroundColor="White"
                            Stroke="#dddddd"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">

                            <Border.Shadow>
                                <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*, Auto">

                                <VerticalStackLayout Spacing="4">

                                    <Label 
                                        Text="{Binding title}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#333" />

                                    <Label 
                                        Text="{Binding category}"
                                        FontSize="14"
                                        TextColor="#666" />

                                    <Label 
                                        Text="{Binding dailyRate, StringFormat='£{0:F2} per day'}"
                                        FontSize="14"
                                        TextColor="#444" />

                                </VerticalStackLayout>

                                <ImageButton 
                                    Grid.Column="1"
                                    Source="chevron_right.png"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BrowseItemsViewModel}}, Path=SelectItemCommand}"
                                    CommandParameter="{Binding}" />

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
