<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RentalApp.Views.BrowseItemsPage"
    x:Name="BrowseItemsPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    Title="Browse Items">

    <Grid RowDefinitions="Auto, *">

        <!-- Error Banner -->
        <Border 
            BackgroundColor="#ffcccc"
            Padding="10"
            IsVisible="{Binding HasError}">
            <Label 
                Text="{Binding ErrorMessage}" 
                TextColor="Black" 
                FontAttributes="Bold" />
        </Border>

        <!-- Items List wrapped in RefreshView -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <!-- Entire card is now tappable -->
                        <Border 
                            Margin="10"
                            Padding="15"
                            BackgroundColor="White"
                            Stroke="#dddddd"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference BrowseItemsPageRoot}, Path=BindingContext.SelectItemCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*, Auto">

                                <VerticalStackLayout Spacing="4">

                                    <Label 
                                        Text="{Binding Title}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#333" />

                                    <Label 
                                        Text="{Binding Category}"
                                        FontSize="14"
                                        TextColor="#666" />

                                    <Label 
                                        Text="{Binding DailyRate, StringFormat='£{0:F2} per day'}"
                                        FontSize="14"
                                        TextColor="#444" />

                                </VerticalStackLayout>

                                <!-- Chevron icon only, no command -->
                                <Label 
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    TextColor="#999" />

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
