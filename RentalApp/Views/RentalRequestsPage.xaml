<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RentalApp.Views.RentalRequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    Title="Rental Requests">

    <!-- Use a Grid so the CollectionView gets full height -->
    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Error Banner -->
        <Border Grid.Row="0"
                BackgroundColor="#ffcccc"
                Padding="10"
                IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Black"
                   FontAttributes="Bold" />
        </Border>

        <!-- Requests List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding IncomingRequests}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="No rental requests yet."
                           FontSize="18"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#ddd"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding BorrowerId, StringFormat='Borrower ID: {0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding ApiItemId, StringFormat='Item ID: {0}'}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <Label Text="{Binding Status}"
                                   FontSize="14"
                                   TextColor="DarkRed"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding LastSynced, StringFormat='Updated: {0:dd MMM HH:mm}'}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">

                                <Button Text="Approve"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RentalRequestsViewModel}}, Path=ApproveCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#28a745"
                                        TextColor="White"
                                        CornerRadius="8" />

                                <Button Text="Reject"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RentalRequestsViewModel}}, Path=RejectCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#dc3545"
                                        TextColor="White"
                                        CornerRadius="8" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
