<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RentalApp.Views.UserDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding PageTitle}"
             Shell.BackButtonBehavior="{x:Null}">

    <!-- BindingContext is set in code-behind via DI -->

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" 
                     Command="{Binding NavigateToDashboardCommand}"
                     IconImageSource="home.png" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid Padding="20" RowSpacing="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="0"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,0,0,20" />

            <!-- Main Content -->
            <VerticalStackLayout Grid.Row="1"
                                 IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                 Spacing="20">

                <!-- Error Banner -->
                <Border BackgroundColor="{StaticResource Danger}"
                        Padding="15"
                        StrokeThickness="0"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Border>

                <!-- Success Banner -->
                <Border BackgroundColor="{StaticResource Success}"
                        Padding="15"
                        StrokeThickness="0"
                        IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}">
                    <Label Text="{Binding SuccessMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Border>

                <!-- User Information Card -->
                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Stroke="#dddddd"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,4" Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <Label Text="User Information"
                               FontSize="18"
                               FontAttributes="Bold"
                               Margin="0,0,0,10" />

                        <!-- First Name -->
                        <VerticalStackLayout>
                            <Label Text="First Name"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding FirstName}"
                                   Placeholder="Enter first name"
                                   FontSize="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
                        </VerticalStackLayout>

                        <!-- Last Name -->
                        <VerticalStackLayout>
                            <Label Text="Last Name"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding LastName}"
                                   Placeholder="Enter last name"
                                   FontSize="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout>
                            <Label Text="Email"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="Enter email address"
                                   Keyboard="Email"
                                   FontSize="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
                        </VerticalStackLayout>

                        <!-- Password Fields -->
                        <VerticalStackLayout IsVisible="{Binding ShowPasswordFields}">
                            <VerticalStackLayout>
                                <Label Text="Password"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Entry Text="{Binding Password}"
                                       Placeholder="Enter password"
                                       IsPassword="True"
                                       FontSize="16"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Label Text="Confirm Password"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Entry Text="{Binding ConfirmPassword}"
                                       Placeholder="Confirm password"
                                       IsPassword="True"
                                       FontSize="16"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Active Status -->
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding IsActive}"
                                    OnColor="{StaticResource Success}"
                                    ThumbColor="White" />
                            <Label Text="User Active"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Roles Card -->
                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Stroke="#dddddd"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        IsVisible="{Binding IsNewUser, Converter={StaticResource InvertedBoolConverter}}">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,4" Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <Label Text="User Roles"
                               FontSize="18"
                               FontAttributes="Bold"
                               Margin="0,0,0,10" />

                        <CollectionView ItemsSource="{Binding AvailableRoles}"
                                        BackgroundColor="Transparent">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}" />
                                        </VerticalStackLayout>

                                        <!-- Add Role -->
                                        <Button Grid.Column="1"
                                                Text="{Binding ButtonText}"
                                                BackgroundColor="{Binding ButtonColor}"
                                                TextColor="White"
                                                FontSize="14"
                                                CornerRadius="6"
                                                Padding="15,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddRoleCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsAssigned, Converter={StaticResource InvertedBoolConverter}}" />

                                        <!-- Remove Role -->
                                        <Button Grid.Column="1"
                                                Text="{Binding ButtonText}"
                                                BackgroundColor="{Binding ButtonColor}"
                                                TextColor="White"
                                                FontSize="14"
                                                CornerRadius="6"
                                                Padding="15,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveRoleCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsAssigned}" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Action Buttons -->
            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="15"
                                   Margin="0,20,0,0">

                <Button Text="Back"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                        Command="{Binding BackCommand}"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"
                        HorizontalOptions="Fill" />

                <Button Text="Save"
                        BackgroundColor="#FF12101A"
                        TextColor="White"
                        Command="{Binding SaveUserCommand}"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        HorizontalOptions="Fill" />

                <Button Text="Delete"
                        BackgroundColor="{StaticResource Danger}"
                        TextColor="White"
                        Command="{Binding DeleteUserCommand}"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding CanDeleteCurrentUser}" />

            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
