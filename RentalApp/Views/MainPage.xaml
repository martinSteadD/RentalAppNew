<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RentalApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    Title="Dashboard">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Error Banner -->
            <Border 
                BackgroundColor="#ffcccc"
                Padding="10"
                IsVisible="{Binding HasError}">
                <Label 
                    Text="{Binding ErrorMessage}" 
                    TextColor="Black" 
                    FontAttributes="Bold" />
            </Border>

            <!-- Welcome Section -->
            <Border 
                Padding="20"
                BackgroundColor="#007aff"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">

                <Border.Shadow>
                    <Shadow Brush="#00000033" Offset="0,4" Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label 
                        Text="{Binding WelcomeMessage}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label 
                        Text="{Binding UserEmail}"
                        FontSize="16"
                        TextColor="White"
                        Opacity="0.8" />
                </VerticalStackLayout>

            </Border>

            <!-- Quick Actions Header -->
            <Label 
                Text="Quick Actions"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <!-- Action Cards -->
            <VerticalStackLayout Spacing="15">

                <!-- Browse Items -->
                <Border 
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#dddddd"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToBrowseCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label 
                            Text="📦"
                            FontSize="28"
                            VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0">
                            <Label Text="Browse Items" FontSize="18" FontAttributes="Bold" />
                            <Label Text="View all available items" FontSize="14" TextColor="#666" />
                        </VerticalStackLayout>

                        <Label 
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            VerticalOptions="Center"
                            TextColor="#999" />
                    </Grid>
                </Border>

                <!-- My Rentals -->
                <Border 
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#dddddd"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMyRentalsCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label 
                            Text="📄"
                            FontSize="28"
                            VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0">
                            <Label Text="My Rentals" FontSize="18" FontAttributes="Bold" />
                            <Label Text="View your rental history" FontSize="14" TextColor="#666" />
                        </VerticalStackLayout>

                        <Label 
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            VerticalOptions="Center"
                            TextColor="#999" />
                    </Grid>
                </Border>

                <!-- Create Item -->
                <Border 
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#dddddd"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCreateItemCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label 
                            Text="➕"
                            FontSize="28"
                            VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0">
                            <Label Text="Create Item" FontSize="18" FontAttributes="Bold" />
                            <Label Text="List a new item for rental" FontSize="14" TextColor="#666" />
                        </VerticalStackLayout>

                        <Label 
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            VerticalOptions="Center"
                            TextColor="#999" />
                    </Grid>
                </Border>

                <!-- Profile -->
                <Border 
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#dddddd"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Border.Shadow>
                        <Shadow Brush="#00000022" Offset="0,3" Radius="8" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label 
                            Text="👤"
                            FontSize="28"
                            VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0">
                            <Label Text="My Profile" FontSize="18" FontAttributes="Bold" />
                            <Label Text="View your account details" FontSize="14" TextColor="#666" />
                        </VerticalStackLayout>

                        <Label 
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            VerticalOptions="Center"
                            TextColor="#999" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
