<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RentalApp.ViewModels"
    x:Class="RentalApp.Views.ProfilePage"
    Title="My Profile">

    <!-- Toolbar Logout -->
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Logout"
            IconImageSource="logout.png"
            Command="{Binding LogoutCommand}"
            Priority="0"
            Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Error Banner -->
            <Border 
                BackgroundColor="#ffcccc"
                Padding="10"
                IsVisible="{Binding HasError}">
                <Label 
                    Text="{Binding ErrorMessage}" 
                    TextColor="Black" 
                    FontAttributes="Bold" />
            </Border>

            <!-- Profile Card -->
            <Border 
                Padding="20"
                BackgroundColor="White"
                Stroke="#dddddd"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <Border.Shadow>
                    <Shadow Brush="#00000022" Offset="0,4" Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <!-- Full Name -->
                    <Label 
                        Text="{Binding FullName}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#222" />

                    <!-- Email -->
                    <Label 
                        Text="{Binding CurrentUser.Email}"
                        FontSize="18"
                        TextColor="#666" />

                    <!-- Join Date -->
                    <Label 
                        Text="{Binding JoinDateFormatted}"
                        FontSize="14"
                        TextColor="#777" />

                    <!-- Rating -->
                    <Label 
                        Text="{Binding DisplayRating}"
                        FontSize="18"
                        TextColor="#007aff"
                        FontAttributes="Bold" />

                    <!-- Items Listed -->
                    <Label 
                        Text="{Binding ItemsListedFormatted}"
                        FontSize="16"
                        TextColor="#444" />

                    <!-- Rentals Completed -->
                    <Label 
                        Text="{Binding RentalsCompletedFormatted}"
                        FontSize="16"
                        TextColor="#444" />

                </VerticalStackLayout>

            </Border>

            <!-- Loading Indicator -->
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#007aff" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
